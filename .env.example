# --- BetterAuth -------------------------------------------------------------
# Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the app (http://localhost:3000 locally, your Vercel URL in production)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Leave empty for local development -> a ./sqlite.db file is used.
# On Vercel set a Postgres URL (Neon, Supabase, Vercel Postgres ...)
DATABASE_URL=

# --- Social login (optional, buttons show an error toast until configured) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
